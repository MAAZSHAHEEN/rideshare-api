# Development placeholders only. Set your own values in .env or the environment.
# Compose reads these to initialize a NEW database volume; changing them does
# not change credentials in an existing volume.
POSTGRES_USER=postgres
POSTGRES_DB=rideshare
POSTGRES_PASSWORD=replace-with-local-database-password

# Host Python + Compose PostgreSQL: localhost:5433.
# API inside Compose: use db:5432. Native PostgreSQL may use localhost:5432.
# Match the database credentials above; URL-encode special password characters.
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-local-database-password@localhost:5433/rideshare
SECRET_KEY=replace-with-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
