# Development placeholders only. Set your own values in .env or the environment.
# Compose reads these to initialize a NEW database volume; changing them does
# not change credentials in an existing volume.
POSTGRES_USER=postgres
POSTGRES_DB=rideshare
POSTGRES_PASSWORD=replace-with-local-database-password

# Host Python + Compose PostgreSQL: localhost:5433.
# API inside Compose: use db:5432. Native PostgreSQL may use localhost:5432.
# Match the database credentials above; URL-encode special password characters.
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-local-database-password@localhost:5433/rideshare
SECRET_KEY=replace-with-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Exact frontend origins, comma-separated; no paths or trailing slashes.
# Set your deployed frontend origin explicitly in production. Empty disables CORS.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OFF until the deployment's ASGI client-IP trust boundary is verified.
# Do not parse/trust forwarded headers in application code.
AUTH_RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT_CLIENT_IP_SOURCE=unverified
# When approved: verified-asgi, TLS Redis URL, and a separate random >=32-byte key.
AUTH_RATE_LIMIT_REDIS_URL=
AUTH_RATE_LIMIT_HMAC_KEY=
AUTH_RATE_LIMIT_NAMESPACE=rideshare:auth:v1
AUTH_RATE_LIMIT_LOGIN_LIMIT=30
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REGISTER_LIMIT=5
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_LOGIN_IDENTITY_LIMIT=5
AUTH_RATE_LIMIT_LOGIN_IDENTITY_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_TIMEOUT_SECONDS=0.5
